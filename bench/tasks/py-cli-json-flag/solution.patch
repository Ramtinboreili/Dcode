@@ -0,0 +1,19 @@
+import contextlib
+import io
+import json
+import os
+import tempfile
+import unittest
+
+import du
+
+
+class JsonFlag(unittest.TestCase):
+    def test_json(self):
+        with tempfile.TemporaryDirectory() as root:
+            with open(os.path.join(root, "a"), "w") as handle:
+                handle.write("xx")
+            out = io.StringIO()
+            with contextlib.redirect_stdout(out):
+                du.main([root, "--json"])
+            self.assertEqual(json.loads(out.getvalue()), [{"path": "a", "bytes": 2, "human": "2B"}])
