+"""RFC 6902 JSON Patch, and a diff that produces it."""
+import copy
+
+from jsonkit.pointer import PointerError, index_of, resolve, split
+
+
+class PatchError(ValueError):
+    pass
+
+
+def _same(a, b):
+    """JSON equality: 1 == 1.0, but true is not 1."""
+    if isinstance(a, bool) or isinstance(b, bool):
+        return a is b
+    if isinstance(a, dict) and isinstance(b, dict):
+        return a.keys() == b.keys() and all(_same(a[k], b[k]) for k in a)
+    if isinstance(a, list) and isinstance(b, list):
+        return len(a) == len(b) and all(_same(x, y) for x, y in zip(a, b))
+    return a == b
+
+
+def _parent(doc, tokens):
+    parent = doc
+    for token in tokens[:-1]:
+        if isinstance(parent, dict):
+            if token not in parent:
+                raise PatchError(f"no key {token!r}")
+            parent = parent[token]
+        elif isinstance(parent, list):
+            parent = parent[index_of(token, len(parent))]
+        else:
+            raise PatchError("path goes through a scalar")
+    return parent, tokens[-1]
+
+
+def _add(doc, path, value):
+    tokens = split(path)
+    if not tokens:
+        return value
+    parent, token = _parent(doc, tokens)
+    if isinstance(parent, dict):
+        parent[token] = value
+    elif isinstance(parent, list):
+        parent.insert(index_of(token, len(parent), allow_end=True), value)
+    else:
+        raise PatchError("can't add into a scalar")
+    return doc
+
+
+def _remove(doc, path):
+    tokens = split(path)
+    if not tokens:
+        return None
+    parent, token = _parent(doc, tokens)
+    if isinstance(parent, dict):
+        if token not in parent:
+            raise PatchError(f"no key {token!r}")
+        del parent[token]
+    elif isinstance(parent, list):
+        del parent[index_of(token, len(parent))]
+    else:
+        raise PatchError("can't remove from a scalar")
+    return doc
+
+
+def apply_patch(doc, ops):
+    doc = copy.deepcopy(doc)
+    try:
+        for op in ops:
+            kind = op["op"]
+            path = op["path"]
+            if kind == "add":
+                doc = _add(doc, path, copy.deepcopy(op["value"]))
+            elif kind == "remove":
+                resolve(doc, path)
+                doc = _remove(doc, path)
+            elif kind == "replace":
+                resolve(doc, path)
+                doc = _add(_remove(doc, path), path, copy.deepcopy(op["value"])) if path else copy.deepcopy(op["value"])
+            elif kind == "move":
+                source = op["from"]
+                if path == source:
+                    resolve(doc, source)
+                    continue
+                if path.startswith(source + "/"):
+                    raise PatchError("can't move into itself")
+                value = resolve(doc, source)
+                doc = _add(_remove(doc, source), path, value)
+            elif kind == "copy":
+                doc = _add(doc, path, copy.deepcopy(resolve(doc, op["from"])))
+            elif kind == "test":
+                if not _same(resolve(doc, path), op["value"]):
+                    raise PatchError(f"test failed at {path}")
+            else:
+                raise PatchError(f"unknown op {kind!r}")
+    except (PointerError, KeyError, TypeError, AttributeError) as exc:
+        raise PatchError(str(exc)) from exc
+    return doc
+
+
+def _escape(token):
+    return str(token).replace("~", "~0").replace("/", "~1")
+
+
+def diff(a, b, path=""):
+    if _same(a, b):
+        return []
+    if isinstance(a, dict) and isinstance(b, dict):
+        ops = []
+        for key in a:
+            if key not in b:
+                ops.append({"op": "remove", "path": f"{path}/{_escape(key)}"})
+        for key in b:
+            where = f"{path}/{_escape(key)}"
+            if key in a:
+                ops += diff(a[key], b[key], where)
+            else:
+                ops.append({"op": "add", "path": where, "value": copy.deepcopy(b[key])})
+        return ops
+    if isinstance(a, list) and isinstance(b, list):
+        ops = []
+        for index in range(min(len(a), len(b))):
+            ops += diff(a[index], b[index], f"{path}/{index}")
+        for index in range(len(a) - 1, len(b) - 1, -1):
+            ops.append({"op": "remove", "path": f"{path}/{index}"})
+        for index in range(len(a), len(b)):
+            ops.append({"op": "add", "path": f"{path}/{index}", "value": copy.deepcopy(b[index])})
+        return ops
+    return [{"op": "replace", "path": path, "value": copy.deepcopy(b)}]
