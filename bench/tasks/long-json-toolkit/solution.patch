+"""A strict JSON reader and writer."""
+import math
+import re
+
+MAX_DEPTH = 200
+_NUMBER = re.compile(r"-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?")
+_ESCAPES = {'"': '"', "\\": "\\", "/": "/", "b": "\b", "f": "\f", "n": "\n", "r": "\r", "t": "\t"}
+_HEX = set("0123456789abcdefABCDEF")
+
+
+class JsonError(ValueError):
+    def __init__(self, message, text, pos):
+        self.pos = pos
+        self.line = text.count("\n", 0, pos) + 1
+        self.col = pos - (text.rfind("\n", 0, pos) + 1) + 1
+        super().__init__(f"{message} at line {self.line} column {self.col}")
+
+
+class _Reader:
+    def __init__(self, text):
+        self.text = text
+        self.pos = 0
+
+    def fail(self, message, pos=None):
+        raise JsonError(message, self.text, self.pos if pos is None else pos)
+
+    def space(self):
+        text, pos = self.text, self.pos
+        while pos < len(text) and text[pos] in " \t\n\r":
+            pos += 1
+        self.pos = pos
+
+    def value(self, depth):
+        if depth > MAX_DEPTH:
+            self.fail("too deep")
+        self.space()
+        if self.pos >= len(self.text):
+            self.fail("unexpected end")
+        char = self.text[self.pos]
+        if char == "{":
+            return self.obj(depth)
+        if char == "[":
+            return self.arr(depth)
+        if char == '"':
+            return self.string()
+        for word, result in (("true", True), ("false", False), ("null", None)):
+            if self.text.startswith(word, self.pos):
+                self.pos += len(word)
+                return result
+        return self.number()
+
+    def number(self):
+        found = _NUMBER.match(self.text, self.pos)
+        if not found:
+            self.fail("expected a value")
+        self.pos = found.end()
+        if found.group(2) or found.group(3):
+            result = float(found.group(0))
+            if math.isinf(result):
+                self.fail("number out of range", found.start())
+            return result
+        return int(found.group(0))
+
+    def hex4(self):
+        chunk = self.text[self.pos:self.pos + 4]
+        if len(chunk) != 4 or not set(chunk) <= _HEX:
+            self.fail("bad \\u escape")
+        self.pos += 4
+        return int(chunk, 16)
+
+    def string(self):
+        start = self.pos
+        self.pos += 1
+        out = []
+        text = self.text
+        while True:
+            if self.pos >= len(text):
+                self.fail("unterminated string", start)
+            char = text[self.pos]
+            if char == '"':
+                self.pos += 1
+                return "".join(out)
+            if ord(char) < 0x20:
+                self.fail("control character in a string")
+            if 0xD800 <= ord(char) <= 0xDFFF:
+                self.fail("lone surrogate")
+            if char != "\\":
+                out.append(char)
+                self.pos += 1
+                continue
+            self.pos += 1
+            if self.pos >= len(text):
+                self.fail("unterminated string", start)
+            escape = text[self.pos]
+            if escape in _ESCAPES:
+                out.append(_ESCAPES[escape])
+                self.pos += 1
+            elif escape == "u":
+                at = self.pos - 1
+                self.pos += 1
+                code = self.hex4()
+                if 0xDC00 <= code <= 0xDFFF:
+                    self.fail("lone surrogate", at)
+                if 0xD800 <= code <= 0xDBFF:
+                    if text[self.pos:self.pos + 2] != "\\u":
+                        self.fail("lone surrogate", at)
+                    self.pos += 2
+                    low = self.hex4()
+                    if not 0xDC00 <= low <= 0xDFFF:
+                        self.fail("lone surrogate", at)
+                    code = 0x10000 + ((code - 0xD800) << 10) + (low - 0xDC00)
+                out.append(chr(code))
+            else:
+                self.fail("bad escape")
+
+    def arr(self, depth):
+        self.pos += 1
+        out = []
+        self.space()
+        if self.text.startswith("]", self.pos):
+            self.pos += 1
+            return out
+        while True:
+            out.append(self.value(depth + 1))
+            self.space()
+            char = self.text[self.pos:self.pos + 1]
+            self.pos += 1
+            if char == "]":
+                return out
+            if char != ",":
+                self.fail("expected , or ]", self.pos - 1)
+
+    def obj(self, depth):
+        self.pos += 1
+        out = {}
+        self.space()
+        if self.text.startswith("}", self.pos):
+            self.pos += 1
+            return out
+        while True:
+            self.space()
+            if not self.text.startswith('"', self.pos):
+                self.fail("expected a string key")
+            key = self.string()
+            self.space()
+            if not self.text.startswith(":", self.pos):
+                self.fail("expected :")
+            self.pos += 1
+            out[key] = self.value(depth + 1)
+            self.space()
+            char = self.text[self.pos:self.pos + 1]
+            self.pos += 1
+            if char == "}":
+                return out
+            if char != ",":
+                self.fail("expected , or }", self.pos - 1)
+
+
+def loads(text):
+    if not isinstance(text, str):
+        raise TypeError("loads takes a str")
+    reader = _Reader(text)
+    result = reader.value(0)
+    reader.space()
+    if reader.pos != len(text):
+        reader.fail("extra data")
+    return result
+
+
+def _quote(text, ascii_only):
+    out = ['"']
+    for char in text:
+        code = ord(char)
+        if char == '"':
+            out.append('\\"')
+        elif char == "\\":
+            out.append("\\\\")
+        elif code < 0x20:
+            out.append({8: "\\b", 9: "\\t", 10: "\\n", 12: "\\f", 13: "\\r"}.get(code, f"\\u{code:04x}"))
+        elif ascii_only and code > 0x7E:
+            if code > 0xFFFF:
+                code -= 0x10000
+                out.append(f"\\u{0xD800 + (code >> 10):04x}\\u{0xDC00 + (code & 0x3FF):04x}")
+            else:
+                out.append(f"\\u{code:04x}")
+        elif 0xD800 <= code <= 0xDFFF:
+            raise ValueError("lone surrogate")
+        else:
+            out.append(char)
+    out.append('"')
+    return "".join(out)
+
+
+def dumps(value, indent=None, sort_keys=False, ascii_only=False):
+    def write(item, level, seen):
+        if item is None:
+            return "null"
+        if item is True:
+            return "true"
+        if item is False:
+            return "false"
+        if isinstance(item, int):
+            return str(int(item))
+        if isinstance(item, float):
+            if math.isnan(item) or math.isinf(item):
+                raise ValueError("not a JSON number")
+            return repr(float(item))
+        if isinstance(item, str):
+            return _quote(item, ascii_only)
+        if isinstance(item, (list, tuple, dict)):
+            if id(item) in seen:
+                raise ValueError("circular reference")
+            seen = seen | {id(item)}
+            if isinstance(item, dict):
+                for key in item:
+                    if not isinstance(key, str):
+                        raise TypeError("keys must be strings")
+                keys = sorted(item) if sort_keys else list(item)
+                parts = [(_quote(k, ascii_only), item[k]) for k in keys]
+                opening, closing = "{", "}"
+            else:
+                parts = [(None, v) for v in item]
+                opening, closing = "[", "]"
+            if not parts:
+                return opening + closing
+            if indent is None:
+                body = ",".join((f"{k}:" if k else "") + write(v, level, seen) for k, v in parts)
+                return opening + body + closing
+            pad = " " * (indent * (level + 1))
+            body = (",\n").join(pad + (f"{k}: " if k else "") + write(v, level + 1, seen) for k, v in parts)
+            return f"{opening}\n{body}\n{' ' * (indent * level)}{closing}"
+        raise TypeError(f"can't serialize {type(item).__name__}")
+
+    return write(value, 0, frozenset())
