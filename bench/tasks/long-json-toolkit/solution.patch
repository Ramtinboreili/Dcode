+++ b/jsonkit/pointer.py
@@ -0,0 +1,45 @@
+"""RFC 6901 JSON Pointer."""
+import re
+
+_INDEX = re.compile(r"0|[1-9][0-9]*")
+
+
+class PointerError(ValueError):
+    pass
+
+
+def split(pointer):
+    if pointer == "":
+        return []
+    if not isinstance(pointer, str) or not pointer.startswith("/"):
+        raise PointerError(f"bad pointer {pointer!r}")
+    parts = pointer[1:].split("/")
+    for part in parts:
+        if re.search(r"~(?![01])", part):
+            raise PointerError(f"bad escape in {pointer!r}")
+    return [part.replace("~1", "/").replace("~0", "~") for part in parts]
+
+
+def index_of(token, length, allow_end=False):
+    if allow_end and token == "-":
+        return length
+    if not _INDEX.fullmatch(token):
+        raise PointerError(f"bad array index {token!r}")
+    index = int(token)
+    if index > length or (index == length and not allow_end):
+        raise PointerError(f"index {token} out of range")
+    return index
+
+
+def resolve(doc, pointer):
+    current = doc
+    for token in split(pointer):
+        if isinstance(current, dict):
+            if token not in current:
+                raise PointerError(f"no key {token!r}")
+            current = current[token]
+        elif isinstance(current, list):
+            current = current[index_of(token, len(current))]
+        else:
+            raise PointerError(f"can't go into a {type(current).__name__}")
+    return current
