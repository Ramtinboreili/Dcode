diff --git a/roles/app/tasks/main.yml b/roles/app/tasks/main.yml
index 8a2e4ed..a1b045b 100644
--- a/roles/app/tasks/main.yml
+++ b/roles/app/tasks/main.yml
@@ -1,22 +1,28 @@
 - name: create user
   user:
-    name: "{{ service_user }}"
+    name: "{{ app_user }}"
     system: true
 
 - name: download release
-  command: curl -fsSL -o /opt/app-{{ version }}.tgz https://releases.example.internal/app-{{ version }}.tgz
+  command: curl -fsSL -o /opt/app-{{ app_version }}.tgz https://releases.example.internal/app-{{ app_version }}.tgz
+  args:
+    creates: /opt/app-{{ app_version }}.tgz
 
 - name: write config
   template:
     src: app.conf.j2
     dest: /etc/app.conf
-    mode: "0644"
-  notify: restart
+    mode: "0640"
+    owner: root
+    group: "{{ app_user }}"
+  notify: restart app
 
 - name: set db password
   command: /usr/local/bin/app-admin set-password {{ app_db_password }}
+  no_log: true
 
 - name: start service
   service:
     name: app
     state: started
+    enabled: true
