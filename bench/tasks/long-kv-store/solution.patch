+import sys
+
+from kv import KV
+
+
+def main(argv):
+    if len(argv) < 2:
+        print("usage: python -m kv DIR put|get|del|keys|compact ...", file=sys.stderr)
+        return 2
+    folder, command, *rest = argv
+    with KV(folder) as db:
+        if command == "put" and len(rest) == 2:
+            db.put(rest[0], rest[1])
+        elif command == "get" and len(rest) == 1:
+            value = db.get(rest[0])
+            if value is None:
+                return 1
+            print(value)
+        elif command == "del" and len(rest) == 1:
+            db.delete(rest[0])
+        elif command == "keys" and not rest:
+            for key in db.keys():
+                print(key)
+        elif command == "compact" and not rest:
+            db.compact()
+        else:
+            print("bad command", file=sys.stderr)
+            return 2
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
diff --git a/kv/store.py b/kv/store.py
new file mode 100644
index 0000000..ab93212
--- /dev/null
+++ b/kv/store.py
@@ -0,0 +1,147 @@
+"""A log-structured key-value store."""
+import json
+import os
+import zlib
+from pathlib import Path
+
+
+class Closed(Exception):
+    pass
+
+
+def _encode(ops, seq):
+    body = json.dumps({"s": seq, "o": ops}, ensure_ascii=True, separators=(",", ":")).encode()
+    return b"%08x %s\n" % (zlib.crc32(body), body)
+
+
+def _decode(line):
+    head, _, body = line.partition(b" ")
+    if len(head) != 8 or zlib.crc32(body) != int(head, 16):
+        raise ValueError("bad record")
+    return json.loads(body)
+
+
+class Batch:
+    def __init__(self, store):
+        self._store = store
+        self._ops = []
+
+    def put(self, key, value):
+        self._ops.append(["p", key, value])
+
+    def delete(self, key):
+        self._ops.append(["d", key])
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, kind, value, trace):
+        if kind is None and self._ops:
+            self._store._commit(self._ops)
+        return False
+
+
+class KV:
+    def __init__(self, directory):
+        self.dir = Path(directory)
+        self.dir.mkdir(parents=True, exist_ok=True)
+        self._wal_path = self.dir / "wal.log"
+        self._snap_path = self.dir / "snapshot.json"
+        self._data = {}
+        self._seq = 0
+        self._closed = False
+        temp = self.dir / "snapshot.tmp"
+        if temp.exists():
+            temp.unlink()
+        if self._snap_path.exists():
+            snapshot = json.loads(self._snap_path.read_text())
+            self._data = snapshot["data"]
+            self._seq = snapshot["seq"]
+        self._recover()
+        self._wal = open(self._wal_path, "ab")
+
+    def _recover(self):
+        if not self._wal_path.exists():
+            return
+        raw = self._wal_path.read_bytes()
+        good = 0
+        for line in raw.splitlines(keepends=True):
+            if not line.endswith(b"\n"):
+                break
+            try:
+                record = _decode(line[:-1])
+            except ValueError:
+                break
+            good += len(line)
+            if record["s"] > self._seq:  # already in the snapshot otherwise
+                self._apply(record["o"])
+                self._seq = record["s"]
+        if good != len(raw):
+            with open(self._wal_path, "r+b") as handle:
+                handle.truncate(good)
+
+    def _apply(self, ops):
+        for op in ops:
+            if op[0] == "p":
+                self._data[op[1]] = op[2]
+            else:
+                self._data.pop(op[1], None)
+
+    def _commit(self, ops):
+        self._check()
+        self._seq += 1
+        self._wal.write(_encode(ops, self._seq))
+        self._wal.flush()
+        self._apply(ops)
+
+    def _check(self):
+        if self._closed:
+            raise Closed("the store is closed")
+
+    def put(self, key, value):
+        self._commit([["p", key, value]])
+
+    def delete(self, key):
+        self._commit([["d", key]])
+
+    def get(self, key, default=None):
+        self._check()
+        return self._data.get(key, default)
+
+    def keys(self):
+        self._check()
+        return sorted(self._data)
+
+    def items(self):
+        self._check()
+        return sorted(self._data.items())
+
+    def batch(self):
+        self._check()
+        return Batch(self)
+
+    def compact(self):
+        self._check()
+        temp = self.dir / "snapshot.tmp"
+        with open(temp, "w") as handle:
+            json.dump({"seq": self._seq, "data": self._data}, handle)
+            handle.flush()
+            os.fsync(handle.fileno())
+        os.replace(temp, self._snap_path)
+        self._wal.close()
+        self._wal = open(self._wal_path, "wb")
+
+    def disk_size(self):
+        return sum(path.stat().st_size for path in self.dir.iterdir() if path.is_file())
+
+    def close(self):
+        if not self._closed:
+            self._closed = True
+            self._wal.close()
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *exc):
+        self.close()
+        return False
