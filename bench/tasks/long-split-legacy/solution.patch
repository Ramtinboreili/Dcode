+"""The command line."""
+import argparse
+import sys
+
+from inventory.models import ValidationError
+from inventory.pricing import order_total
+from inventory.reports import REPORTS, warehouse_summary
+from inventory.storage import build_warehouses, load_count, load_items, save_items
+
+def cmd_report(args):
+    items = load_items(args.file)
+    fn = REPORTS.get(args.name)
+    if fn is None:
+        print(f"unknown report {args.name}", file=sys.stderr)
+        return 2
+    print(fn(items))
+    return 0
+
+
+def cmd_all(args):
+    items = load_items(args.file)
+    for name in sorted(REPORTS):
+        print("== " + name)
+        print(REPORTS[name](items))
+    print(f"(loaded {load_count()} times)")
+    return 0
+
+
+def cmd_summary(args):
+    print(warehouse_summary(build_warehouses(load_items(args.file))))
+    return 0
+
+
+def cmd_quote(args):
+    items = {item.sku: item for item in load_items(args.file)}
+    if args.sku not in items:
+        print(f"no such sku {args.sku}", file=sys.stderr)
+        return 2
+    try:
+        print(f"{order_total(items[args.sku], args.qty):.2f}")
+    except ValidationError as exc:
+        print(exc, file=sys.stderr)
+        return 3
+    return 0
+
+
+def cmd_restock(args):
+    items = load_items(args.file)
+    for item in items:
+        if item.sku == args.sku:
+            item.qty += args.qty
+    save_items(args.file, items)
+    print("ok")
+    return 0
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(prog="inventory")
+    parser.add_argument("file")
+    commands = parser.add_subparsers(dest="command", required=True)
+    report = commands.add_parser("report")
+    report.add_argument("name")
+    report.set_defaults(run=cmd_report)
+    commands.add_parser("all").set_defaults(run=cmd_all)
+    commands.add_parser("summary").set_defaults(run=cmd_summary)
+    quote = commands.add_parser("quote")
+    quote.add_argument("sku")
+    quote.add_argument("qty", type=int)
+    quote.set_defaults(run=cmd_quote)
+    restock = commands.add_parser("restock")
+    restock.add_argument("sku")
+    restock.add_argument("qty", type=int)
+    restock.set_defaults(run=cmd_restock)
+    args = parser.parse_args(argv)
+    try:
+        return args.run(args)
+    except ValidationError as exc:
+        print(f"invalid: {exc}", file=sys.stderr)
+        return 4
diff --git a/inventory/models.py b/inventory/models.py
new file mode 100644
index 0000000..4dcbf8c
--- /dev/null
+++ b/inventory/models.py
@@ -0,0 +1,45 @@
+"""The data model."""
+
+class Item:
+    def __init__(self, sku, name, category, qty, cost, price, warehouse):
+        self.sku = sku
+        self.name = name
+        self.category = category
+        self.qty = qty
+        self.cost = cost
+        self.price = price
+        self.warehouse = warehouse
+
+    def margin(self):
+        return self.price - self.cost
+
+    def stock_value(self):
+        return self.qty * self.cost
+
+    def retail_value(self):
+        return self.qty * self.price
+
+    def __repr__(self):
+        return f"Item({self.sku}, {self.qty})"
+
+
+class Warehouse:
+    def __init__(self, code):
+        self.code = code
+        self.items = []
+
+    def add(self, item):
+        self.items.append(item)
+
+    def total_qty(self):
+        return sum(item.qty for item in self.items)
+
+    def total_value(self):
+        return sum(item.stock_value() for item in self.items)
+
+    def categories(self):
+        return sorted({item.category for item in self.items})
+
+
+class ValidationError(Exception):
+    pass
