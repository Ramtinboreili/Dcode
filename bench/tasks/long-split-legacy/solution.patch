+"""Text reports."""
+from inventory.pricing import markup, needs_reprice, price_with_tax, tax_rate
+
+def report_qty_by_category(items):
+    totals = {}
+    for item in items:
+        totals[item.category] = totals.get(item.category, 0) + item.qty
+    lines = [f"{'CATEGORY':<10} {'QTY':>12}"]
+    for name in sorted(totals):
+        lines.append(f"{name:<10} {totals[name]:>12.2f}")
+    lines.append(f"{'TOTAL':<10} {sum(totals.values()):>12.2f}")
+    return "\n".join(lines)
+
+def report_value_by_category(items):
+    totals = {}
+    for item in items:
+        totals[item.category] = totals.get(item.category, 0) + item.stock_value()
+    lines = [f"{'CATEGORY':<10} {'VALUE':>12}"]
+    for name in sorted(totals):
+        lines.append(f"{name:<10} {totals[name]:>12.2f}")
+    lines.append(f"{'TOTAL':<10} {sum(totals.values()):>12.2f}")
+    return "\n".join(lines)
+
+def report_retail_by_category(items):
+    totals = {}
+    for item in items:
+        totals[item.category] = totals.get(item.category, 0) + item.retail_value()
+    lines = [f"{'CATEGORY':<10} {'RETAIL':>12}"]
+    for name in sorted(totals):
+        lines.append(f"{name:<10} {totals[name]:>12.2f}")
+    lines.append(f"{'TOTAL':<10} {sum(totals.values()):>12.2f}")
+    return "\n".join(lines)
+
+def report_margin_by_category(items):
+    totals = {}
+    for item in items:
+        totals[item.category] = totals.get(item.category, 0) + item.margin() * item.qty
+    lines = [f"{'CATEGORY':<10} {'MARGIN':>12}"]
+    for name in sorted(totals):
+        lines.append(f"{name:<10} {totals[name]:>12.2f}")
+    lines.append(f"{'TOTAL':<10} {sum(totals.values()):>12.2f}")
+    return "\n".join(lines)
+
+def report_qty_by_warehouse(items):
+    totals = {}
+    for item in items:
+        totals[item.warehouse] = totals.get(item.warehouse, 0) + item.qty
+    lines = [f"{'WAREHOUSE':<10} {'QTY':>12}"]
+    for name in sorted(totals):
+        lines.append(f"{name:<10} {totals[name]:>12.2f}")
+    lines.append(f"{'TOTAL':<10} {sum(totals.values()):>12.2f}")
+    return "\n".join(lines)
+
+def report_value_by_warehouse(items):
+    totals = {}
+    for item in items:
+        totals[item.warehouse] = totals.get(item.warehouse, 0) + item.stock_value()
+    lines = [f"{'WAREHOUSE':<10} {'VALUE':>12}"]
+    for name in sorted(totals):
+        lines.append(f"{name:<10} {totals[name]:>12.2f}")
+    lines.append(f"{'TOTAL':<10} {sum(totals.values()):>12.2f}")
+    return "\n".join(lines)
+
+def report_retail_by_warehouse(items):
+    totals = {}
+    for item in items:
+        totals[item.warehouse] = totals.get(item.warehouse, 0) + item.retail_value()
+    lines = [f"{'WAREHOUSE':<10} {'RETAIL':>12}"]
+    for name in sorted(totals):
+        lines.append(f"{name:<10} {totals[name]:>12.2f}")
+    lines.append(f"{'TOTAL':<10} {sum(totals.values()):>12.2f}")
+    return "\n".join(lines)
+
+def report_margin_by_warehouse(items):
+    totals = {}
+    for item in items:
+        totals[item.warehouse] = totals.get(item.warehouse, 0) + item.margin() * item.qty
+    lines = [f"{'WAREHOUSE':<10} {'MARGIN':>12}"]
+    for name in sorted(totals):
+        lines.append(f"{name:<10} {totals[name]:>12.2f}")
+    lines.append(f"{'TOTAL':<10} {sum(totals.values()):>12.2f}")
+    return "\n".join(lines)
+
+def report_low_stock(items, limit=5):
+    rows = [item for item in items if item.qty < limit]
+    rows.sort(key=lambda item: (item.qty, item.sku))
+    lines = [f"LOW STOCK ({len(rows)})"]
+    for item in rows:
+        lines.append(f"{item.sku:<8} {item.name:<20} {item.qty:>5} {item.warehouse:<4} {price_with_tax(item):>9.2f}")
+    return "\n".join(lines)
+
+def report_overstock(items, limit=5):
+    rows = [item for item in items if item.qty > limit * 20]
+    rows.sort(key=lambda item: (item.qty, item.sku))
+    lines = [f"OVERSTOCK ({len(rows)})"]
+    for item in rows:
+        lines.append(f"{item.sku:<8} {item.name:<20} {item.qty:>5} {item.warehouse:<4} {price_with_tax(item):>9.2f}")
+    return "\n".join(lines)
+
+def report_reprice(items, limit=5):
+    rows = [item for item in items if needs_reprice(item)]
+    rows.sort(key=lambda item: (item.qty, item.sku))
+    lines = [f"REPRICE ({len(rows)})"]
+    for item in rows:
+        lines.append(f"{item.sku:<8} {item.name:<20} {item.qty:>5} {item.warehouse:<4} {price_with_tax(item):>9.2f}")
+    return "\n".join(lines)
+
+def report_out_of_stock(items, limit=5):
+    rows = [item for item in items if item.qty == 0]
+    rows.sort(key=lambda item: (item.qty, item.sku))
+    lines = [f"OUT OF STOCK ({len(rows)})"]
+    for item in rows:
+        lines.append(f"{item.sku:<8} {item.name:<20} {item.qty:>5} {item.warehouse:<4} {price_with_tax(item):>9.2f}")
+    return "\n".join(lines)
+
+def report_high_margin(items, limit=5):
+    rows = [item for item in items if markup(item) > 1]
+    rows.sort(key=lambda item: (item.qty, item.sku))
+    lines = [f"HIGH MARGIN ({len(rows)})"]
+    for item in rows:
+        lines.append(f"{item.sku:<8} {item.name:<20} {item.qty:>5} {item.warehouse:<4} {price_with_tax(item):>9.2f}")
+    return "\n".join(lines)
+
+def report_untaxed(items, limit=5):
+    rows = [item for item in items if tax_rate(item.category) == 0]
+    rows.sort(key=lambda item: (item.qty, item.sku))
+    lines = [f"UNTAXED ({len(rows)})"]
+    for item in rows:
+        lines.append(f"{item.sku:<8} {item.name:<20} {item.qty:>5} {item.warehouse:<4} {price_with_tax(item):>9.2f}")
+    return "\n".join(lines)
+
+def report_top_value(items, count=3):
+    rows = sorted(items, key=lambda item: (-(item.stock_value()), item.sku))[:count]
+    lines = [f"TOP VALUE"]
+    for rank, item in enumerate(rows, 1):
+        lines.append(f"{rank}. {item.sku:<8} {item.name:<20} {item.stock_value():>10.2f}")
+    return "\n".join(lines)
+
+def report_top_retail(items, count=3):
+    rows = sorted(items, key=lambda item: (-(item.retail_value()), item.sku))[:count]
+    lines = [f"TOP RETAIL"]
+    for rank, item in enumerate(rows, 1):
+        lines.append(f"{rank}. {item.sku:<8} {item.name:<20} {item.retail_value():>10.2f}")
+    return "\n".join(lines)
+
+def report_top_margin(items, count=3):
+    rows = sorted(items, key=lambda item: (-(item.margin()), item.sku))[:count]
+    lines = [f"TOP MARGIN"]
+    for rank, item in enumerate(rows, 1):
+        lines.append(f"{rank}. {item.sku:<8} {item.name:<20} {item.margin():>10.2f}")
+    return "\n".join(lines)
+
+def report_top_qty(items, count=3):
+    rows = sorted(items, key=lambda item: (-(item.qty), item.sku))[:count]
+    lines = [f"TOP QTY"]
+    for rank, item in enumerate(rows, 1):
+        lines.append(f"{rank}. {item.sku:<8} {item.name:<20} {item.qty:>10.2f}")
+    return "\n".join(lines)
+
+REPORTS = {
+    "qty_by_category": report_qty_by_category,
+    "value_by_category": report_value_by_category,
+    "retail_by_category": report_retail_by_category,
+    "margin_by_category": report_margin_by_category,
+    "qty_by_warehouse": report_qty_by_warehouse,
+    "value_by_warehouse": report_value_by_warehouse,
+    "retail_by_warehouse": report_retail_by_warehouse,
+    "margin_by_warehouse": report_margin_by_warehouse,
+    "low_stock": report_low_stock,
+    "overstock": report_overstock,
+    "reprice": report_reprice,
+    "out_of_stock": report_out_of_stock,
+    "high_margin": report_high_margin,
+    "untaxed": report_untaxed,
+    "top_value": report_top_value,
+    "top_retail": report_top_retail,
+    "top_margin": report_top_margin,
+    "top_qty": report_top_qty,
+}
+
+
+def warehouse_summary(warehouses):
+    lines = []
+    for code in sorted(warehouses):
+        house = warehouses[code]
+        lines.append(f"{code}: {house.total_qty()} units, {house.total_value():.2f}, {', '.join(house.categories())}")
+    return "\n".join(lines)
