@@ -0,0 +1,64 @@
+"""Reading and writing the CSV."""
+import csv
+
+from inventory.models import Item, ValidationError, Warehouse
+
+COLUMNS = ["sku", "name", "category", "qty", "cost", "price", "warehouse"]
+_LOAD_COUNT = {"n": 0}
+
+
+def load_count():
+    return _LOAD_COUNT["n"]
+
+
+def parse_row(row, line):
+    if len(row) != len(COLUMNS):
+        raise ValidationError(f"line {line}: expected {len(COLUMNS)} columns, got {len(row)}")
+    sku, name, category, qty, cost, price, warehouse = row
+    if not sku:
+        raise ValidationError(f"line {line}: empty sku")
+    try:
+        qty = int(qty)
+    except ValueError:
+        raise ValidationError(f"line {line}: bad qty {qty!r}")
+    try:
+        cost, price = float(cost), float(price)
+    except ValueError:
+        raise ValidationError(f"line {line}: bad money")
+    if qty < 0:
+        raise ValidationError(f"line {line}: negative qty")
+    return Item(sku, name, category, qty, cost, price, warehouse)
+
+
+def load_items(path):
+    _LOAD_COUNT["n"] += 1
+    items, seen = [], set()
+    with open(path, newline="") as handle:
+        reader = csv.reader(handle)
+        header = next(reader)
+        if header != COLUMNS:
+            raise ValidationError("bad header")
+        for line, row in enumerate(reader, 2):
+            if not row or row[0].startswith("#"):
+                continue
+            item = parse_row(row, line)
+            if item.sku in seen:
+                raise ValidationError(f"line {line}: duplicate sku {item.sku}")
+            seen.add(item.sku)
+            items.append(item)
+    return items
+
+
+def build_warehouses(items):
+    out = {}
+    for item in items:
+        out.setdefault(item.warehouse, Warehouse(item.warehouse)).add(item)
+    return out
+
+
+def save_items(path, items):
+    with open(path, "w", newline="") as handle:
+        writer = csv.writer(handle, lineterminator="\n")
+        writer.writerow(COLUMNS)
+        for item in items:
+            writer.writerow([item.sku, item.name, item.category, item.qty, f"{item.cost:.2f}", f"{item.price:.2f}", item.warehouse])
