+"""Tax and discounts."""
+from inventory.models import ValidationError
+
+TAX = {"food": 0.05, "books": 0.0, "tools": 0.2, "toys": 0.2, "garden": 0.1}
+DISCOUNT_STEPS = [(100, 0.15), (50, 0.1), (10, 0.05)]
+
+
+def tax_rate(category):
+    return TAX.get(category, 0.2)
+
+
+def price_with_tax(item):
+    return round(item.price * (1 + tax_rate(item.category)), 2)
+
+
+def volume_discount(qty):
+    for threshold, rate in DISCOUNT_STEPS:
+        if qty >= threshold:
+            return rate
+    return 0.0
+
+
+def order_total(item, qty):
+    if qty > item.qty:
+        raise ValidationError(f"only {item.qty} of {item.sku}")
+    gross = price_with_tax(item) * qty
+    return round(gross * (1 - volume_discount(qty)), 2)
+
+
+def markup(item):
+    return (item.price - item.cost) / item.cost if item.cost else 0.0
+
+
+def needs_reprice(item, floor=0.25):
+    return markup(item) < floor
+
+
+def suggested_price(item, target=0.4):
+    return round(item.cost * (1 + target), 2)
