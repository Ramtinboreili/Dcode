diff --git a/pricing.py b/pricing.py
new file mode 100644
index 0000000..474df34
--- /dev/null
+++ b/pricing.py
@@ -0,0 +1,9 @@
+TAX_RATES = {"eu": 0.2, "us": 0.07, "uk": 0.2}
+
+
+def total(subtotal, customer_type, region):
+    if customer_type == "wholesale":
+        subtotal *= 0.8
+    elif customer_type == "member" and subtotal >= 100:
+        subtotal *= 0.95
+    return round(subtotal * (1 + TAX_RATES.get(region, 0.0)), 2)
